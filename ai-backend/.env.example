# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Nothing in here is ever sent to the browser. The Next.js app talks to this
# service through its own /api/ai/* proxy routes.

# ---- Gemini (required) ---------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tried in order. Newer models are better but 429/503 under load, so a fallback
# keeps the intake answering when a single model is unavailable.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1536

# ---- Gemini Live (voice) --------------------------------------------------
# A separate surface from the intake model above: a WebSocket, its own API
# version, and an ephemeral-token handshake. `POST /api/live/token` mints the
# credential; the browser then opens its own wss:// socket to Google, so this
# service never sees the audio and never needs a WebSocket dependency.
#
# The defaults below are the verified-working ones and are unlikely to need
# changing. They are here so a deployment can see what is pinned and why.
#
# v1alpha, not v1beta: both open a socket, but v1beta *rejects*
# `proactivity`, which is the feature that lets the assistant speak up in a
# noisy shelter instead of waiting to be addressed. Verified against the live
# service — do not "upgrade" this.
GEMINI_LIVE_API_VERSION=v1alpha
GEMINI_LIVE_MODEL=gemini-3.8-live
# "Charon" is the Informative prebuilt voice. Gemini does NOT validate this: an
# unknown name is accepted and silently replaced with a default voice, so a
# typo here is invisible. It is pinned into the token and logged on mint.
GEMINI_LIVE_VOICE=Charon
GEMINI_LIVE_LANGUAGE=en-US
# The token authorises a browser to spend our quota. Minted per session and
# single-use; keep it short. The API's own maximum is 20 hours.
GEMINI_LIVE_TOKEN_TTL_SECONDS=900
GEMINI_LIVE_TOKEN_TIMEOUT_SECONDS=15
# How much silence ends a turn. Longer than the default on purpose: a stressed
# reporter pauses mid-sentence, and a cut-off sentence loses a fact.
GEMINI_LIVE_SILENCE_DURATION_MS=900
# Start speaking sooner rather than waiting to be addressed — the microphone is
# always open, so latency is the cost of a missed interruption.
GEMINI_LIVE_START_OF_SPEECH_SENSITIVITY=START_SENSITIVITY_HIGH

# ---- Postgres (required for ticket creation) -----------------------------
# `docker compose up -d db` from this directory provides this.
DATABASE_URL=postgresql://flare:flare@localhost:5432/flare
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ---- HTTP ----------------------------------------------------------------
# Only required for direct browser access. The Next.js proxy makes this moot.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
