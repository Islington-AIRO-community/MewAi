# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Nothing in here is ever sent to the browser. The Next.js app talks to this
# service through its own /api/ai/* proxy routes.

# ---- Gemini (required) ---------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tried in order. Newer models are better but 429/503 under load, so a fallback
# keeps the intake answering when a single model is unavailable.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1536

# ---- Postgres (required for ticket creation) -----------------------------
# `docker compose up -d db` from this directory provides this.
DATABASE_URL=postgresql://flare:flare@localhost:5432/flare
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ---- HTTP ----------------------------------------------------------------
# Only required for direct browser access. The Next.js proxy makes this moot.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
