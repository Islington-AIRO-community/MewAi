# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Nothing in here is ever sent to the browser. These are read server-side only —
# do not add a `NEXT_PUBLIC_` prefix to any of them, or you will publish the
# values to every client.

# ---- AI intake backend (required) -----------------------------------------
# The FastAPI service in ai-backend/. The app talks to it through its own
# /api/ai/* proxy routes, so the browser never learns this address.
#
#   cd ai-backend && ./dev.sh
AI_API_URL=http://127.0.0.1:8000

# ---- Google OAuth ---------------------------------------------------------
# https://console.cloud.google.com/apis/credentials → OAuth client ID → Web app
#
# The redirect URI must be registered with Google and has to match exactly:
#   http://localhost:3000/api/auth/callback/google   (local)
#   https://<your-domain>/api/auth/callback/google   (deployed)
#
# Leave these empty to develop with the rest of the app; /reports is the only
# gated route, and the sign-in button will fail at Google's consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate one with:
#   openssl rand -base64 32
#
# Required in production. In development next-auth will invent an ephemeral one
# and log a warning, which means every restart signs everyone out — fine locally,
# never in a deployment.
NEXTAUTH_SECRET=

# Absolute origin of this app, no trailing slash. Optional on localhost, where
# next-auth infers it, but required behind a proxy or on a real domain or the
# OAuth callback will be rejected as a redirect_uri mismatch.
NEXTAUTH_URL=http://localhost:3000
